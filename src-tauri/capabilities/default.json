{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Least-privilege capability for the main window",
    "windows": ["main", "detail"],
    "permissions": [
        "core:default",
        "core:window:allow-set-title",
        "core:window:allow-close",
        "core:webview:allow-create-webview-window",
        "dialog:default",
        "dialog:allow-open",
        "sql:default",
        "sql:allow-execute",
        "store:default",
        "opener:default",
        "notification:default"
    ]
}
